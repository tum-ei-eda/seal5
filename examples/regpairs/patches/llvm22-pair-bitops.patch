+
+// Pair logic and constant-count shifts keep scalar i64 illegal on RV32.
+def riscv_seal5_xor64 : RVSDNode<"SEAL5_XOR64", SDT_Seal5PairAdd>;
+def riscv_seal5_and64 : RVSDNode<"SEAL5_AND64", SDT_Seal5PairAdd>;
+def SDT_Seal5PairShift : SDTypeProfile<1, 2,
+    [SDTCisVT<0, untyped>, SDTCisVT<1, untyped>, SDTCisVT<2, i32>]>;
+def riscv_seal5_sll64 : RVSDNode<"SEAL5_SLL64", SDT_Seal5PairShift>;
+def riscv_seal5_srl64 : RVSDNode<"SEAL5_SRL64", SDT_Seal5PairShift>;
+def riscv_seal5_sra64 : RVSDNode<"SEAL5_SRA64", SDT_Seal5PairShift>;
+def riscv_seal5_ror64 : RVSDNode<"SEAL5_ROR64", SDT_Seal5PairShift>;
