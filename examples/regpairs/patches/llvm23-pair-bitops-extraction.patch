+static PatternNode *pairCount(PatternNode *N) {
+  while (auto *U = dyn_cast<UnopNode>(N)) {
+    if (U->Op != TargetOpcode::G_ZEXT && U->Op != TargetOpcode::G_ANYEXT &&
+        U->Op != TargetOpcode::G_TRUNC) break;
+    N = U->Operand.get();
+  }
+  return N;
+}
+
+static bool validScalarPairPattern(PatternNode *N) {
+  auto Pair = [](PatternNode *P) {
+    auto *R = dyn_cast<RegisterNode>(P);
+    return R && !R->IsImm && R->llvm_type == "GPRPair";
+  };
+  auto Count = [](PatternNode *P) {
+    auto *R = dyn_cast<RegisterNode>(pairCount(P));
+    return R && R->IsImm && R->Size == 6;
+  };
+  if (auto *B = dyn_cast<BinopNode>(N)) {
+    if (!Pair(B->Left.get())) return false;
+    switch (B->Op) {
+    case TargetOpcode::G_ADD: case TargetOpcode::G_SUB:
+    case TargetOpcode::G_XOR: case TargetOpcode::G_AND:
+      return Pair(B->Right.get());
+    case TargetOpcode::G_SHL: case TargetOpcode::G_LSHR:
+    case TargetOpcode::G_ASHR: case TargetOpcode::G_ROTR:
+      return Count(B->Right.get());
+    default: return false;
+    }
+  }
+  if (auto *T = dyn_cast<TernopNode>(N))
+    return T->Op == TargetOpcode::G_FSHR && Pair(T->First.get()) &&
+           Pair(T->Second.get()) &&
+           cast<RegisterNode>(*T->First).RegIdx == cast<RegisterNode>(*T->Second).RegIdx &&
+           Count(T->Third.get());
+  return false;
+}
+
+// Recognize x >> n | x << ((-n) & 63) only for the same complete pair
+// and a six-bit immediate. Keeping the mask proves defined behavior at n == 0.
+static std::unique_ptr<PatternNode> pairRotateRight(PatternNode *N) {
+  auto *Or = dyn_cast<BinopNode>(N);
+  if (!Or || Or->Op != TargetOpcode::G_OR || N->Type != LLT::scalar(64))
+    return nullptr;
+  auto *Right = dyn_cast<BinopNode>(Or->Left.get());
+  auto *Left = dyn_cast<BinopNode>(Or->Right.get());
+  if (Right && Right->Op == TargetOpcode::G_SHL) std::swap(Right, Left);
+  if (!Right || !Left || Right->Op != TargetOpcode::G_LSHR ||
+      Left->Op != TargetOpcode::G_SHL) return nullptr;
+  auto *A = dyn_cast<RegisterNode>(Right->Left.get());
+  auto *B = dyn_cast<RegisterNode>(Left->Left.get());
+  auto *Count = dyn_cast<RegisterNode>(pairCount(Right->Right.get()));
+  if (!A || !B || A->IsImm || B->IsImm || A->llvm_type != "GPRPair" ||
+      B->llvm_type != "GPRPair" || A->RegIdx != B->RegIdx ||
+      !Count || !Count->IsImm || Count->Size != 6) return nullptr;
+  auto *Mask = dyn_cast<BinopNode>(pairCount(Left->Right.get()));
+  if (!Mask || Mask->Op != TargetOpcode::G_AND) return nullptr;
+  auto *C = dyn_cast<ConstantNode>(Mask->Right.get());
+  auto *Neg = dyn_cast<BinopNode>(Mask->Left.get());
+  if (!C || C->Constant != 63 || !Neg || Neg->Op != TargetOpcode::G_SUB)
+    return nullptr;
+  auto *Zero = dyn_cast<ConstantNode>(Neg->Left.get());
+  auto *Other = dyn_cast<RegisterNode>(pairCount(Neg->Right.get()));
+  if (!Zero || Zero->Constant != 0 || !Other || !Other->IsImm ||
+      Other->Size != 6 || Other->RegIdx != Count->RegIdx) return nullptr;
+  return std::make_unique<BinopNode>(LLT::scalar(64), TargetOpcode::G_ROTR,
+                                   std::move(Right->Left), std::move(Right->Right));
+}
 
