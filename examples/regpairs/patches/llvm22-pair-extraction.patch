+// Recover a vector operation from the optimized XP bit-container expression.
+// Only a complete two-lane arithmetic operation with matching inputs is
+// accepted.
+static bool combinePairArithmeticLanes(Module &M) {
+  bool Changed = false;
+  for (Function &F : M) {
+    if (!F.hasFnAttribute("seal5-regpairs"))
+      continue;
+    SmallVector<StoreInst *, 4> Stores;
+    for (auto &BB : F)
+      for (auto &I : BB)
+        if (auto *S = dyn_cast<StoreInst>(&I))
+          Stores.push_back(S);
+    for (auto *S : Stores) {
+      if (S->isVolatile() || S->isAtomic())
+        continue;
+      auto *Join = dyn_cast<BinaryOperator>(S->getValueOperand());
+      if (!Join || Join->getOpcode() != Instruction::Or ||
+          !Join->getType()->isIntegerTy(64))
+        continue;
+      // InstCombine lifts modulo-32 multiplication into i64 masks. Recognize
+      // the complete low product and high product, including operand swaps.
+      auto Masked = [](Value *V, uint64_t Mask) -> Value * {
+        auto *And = dyn_cast<BinaryOperator>(V);
+        if (!And || And->getOpcode() != Instruction::And)
+          return nullptr;
+        for (unsigned I = 0; I != 2; ++I)
+          if (auto *C = dyn_cast<ConstantInt>(And->getOperand(I));
+              C && C->equalsInt(Mask))
+            return And->getOperand(1 - I);
+        return nullptr;
+      };
+      auto ShiftedHigh = [](Value *V) -> Value * {
+        auto *Shift = dyn_cast<BinaryOperator>(V);
+        auto *C = Shift ? dyn_cast<ConstantInt>(Shift->getOperand(1)) : nullptr;
+        return Shift && Shift->getOpcode() == Instruction::LShr && C &&
+                       C->equalsInt(32)
+                   ? Shift->getOperand(0)
+                   : nullptr;
+      };
+      bool FoldedMul = false;
+      for (unsigned Side = 0; Side != 2 && !FoldedMul; ++Side) {
+        auto *LowMul = dyn_cast_or_null<BinaryOperator>(
+            Masked(Join->getOperand(Side), UINT64_C(0xffffffff)));
+        auto *HighMul = dyn_cast<BinaryOperator>(Join->getOperand(1 - Side));
+        if (!LowMul || !HighMul || LowMul->getOpcode() != Instruction::Mul ||
+            HighMul->getOpcode() != Instruction::Mul)
+          continue;
+        for (unsigned I = 0; I != 2 && !FoldedMul; ++I) {
+          Value *A =
+              Masked(HighMul->getOperand(I), UINT64_C(0xffffffff00000000));
+          Value *B = ShiftedHigh(HighMul->getOperand(1 - I));
+          if (!A || !B ||
+              !((A == LowMul->getOperand(0) && B == LowMul->getOperand(1)) ||
+                (B == LowMul->getOperand(0) && A == LowMul->getOperand(1))))
+            continue;
+          IRBuilder<> Builder(S);
+          auto *VT = FixedVectorType::get(Builder.getInt32Ty(), 2);
+          Value *Result = Builder.CreateMul(Builder.CreateBitCast(A, VT),
+                                            Builder.CreateBitCast(B, VT));
+          auto *NewStore = Builder.CreateAlignedStore(
+              Result, S->getPointerOperand(), S->getAlign());
+          NewStore->setDebugLoc(S->getDebugLoc());
+          S->eraseFromParent();
+          Changed = FoldedMul = true;
+        }
+      }
+      if (FoldedMul)
+        continue;
+      auto GetLaneOp = [](Value *V, bool High) -> BinaryOperator * {
+        if (High) {
+          auto *Shift = dyn_cast<BinaryOperator>(V);
+          auto *C =
+              Shift ? dyn_cast<ConstantInt>(Shift->getOperand(1)) : nullptr;
+          if (!Shift || Shift->getOpcode() != Instruction::Shl || !C ||
+              C->getZExtValue() != 32)
+            return nullptr;
+          V = Shift->getOperand(0);
+        }
+        auto *Ext = dyn_cast<ZExtInst>(V);
+        auto *Add =
+            Ext ? dyn_cast<BinaryOperator>(Ext->getOperand(0)) : nullptr;
+        return Add &&
+                       (Add->getOpcode() == Instruction::Add ||
+                        Add->getOpcode() == Instruction::Sub ||
+                        Add->getOpcode() == Instruction::Mul) &&
+                       Add->getType()->isIntegerTy(32)
+                   ? Add
+                   : nullptr;
+      };
+      BinaryOperator *Low = GetLaneOp(Join->getOperand(0), false),
+                     *High = GetLaneOp(Join->getOperand(1), true);
+      if (!Low || !High) {
+        Low = GetLaneOp(Join->getOperand(1), false);
+        High = GetLaneOp(Join->getOperand(0), true);
+      }
+      if (!Low || !High || Low->getOpcode() != High->getOpcode())
+        continue;
+      auto GetInput = [](Value *V, bool High) -> Value * {
+        auto *Trunc = dyn_cast<TruncInst>(V);
+        if (!Trunc || !Trunc->getSrcTy()->isIntegerTy(64))
+          return nullptr;
+        V = Trunc->getOperand(0);
+        if (!High)
+          return V;
+        auto *Shift = dyn_cast<BinaryOperator>(V);
+        auto *C = Shift ? dyn_cast<ConstantInt>(Shift->getOperand(1)) : nullptr;
+        if (!Shift || Shift->getOpcode() != Instruction::LShr || !C ||
+            C->getZExtValue() != 32)
+          return nullptr;
+        return Shift->getOperand(0);
+      };
+      Value *A = GetInput(Low->getOperand(0), false),
+            *B = GetInput(Low->getOperand(1), false);
+      Value *C = GetInput(High->getOperand(0), true),
+            *D = GetInput(High->getOperand(1), true);
+      if (!A || !B || !C || !D ||
+          !((A == C && B == D) || (Low->isCommutative() && A == D && B == C)))
+        continue;
+      IRBuilder<> Builder(S);
+      auto *VT = FixedVectorType::get(Builder.getInt32Ty(), 2);
+      Value *Result =
+          Builder.CreateBinOp(Low->getOpcode(), Builder.CreateBitCast(A, VT),
+                              Builder.CreateBitCast(B, VT));
+      auto *NewStore = Builder.CreateAlignedStore(
+          Result, S->getPointerOperand(), S->getAlign());
+      NewStore->setDebugLoc(S->getDebugLoc());
+      S->eraseFromParent();
+      Changed = true;
+    }
+  }
+  return Changed;
+}
