+def FeatureSeal5RegPair32Sub : SubtargetFeature<"seal5-regpair32-sub",
+    "HasSeal5RegPair32Sub", "true", "RV32 pair sub", [FeatureSeal5RegPair32]>;
+def HasSeal5RegPair32Sub : Predicate<"!Subtarget->is64Bit() && Subtarget->hasSeal5RegPair32Sub()">;
+def FeatureSeal5RegPair32Mul : SubtargetFeature<"seal5-regpair32-mul",
+    "HasSeal5RegPair32Mul", "true", "RV32 pair mul", [FeatureSeal5RegPair32]>;
