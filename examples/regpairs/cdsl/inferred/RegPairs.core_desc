            X[rd] = result[31:0];
            X[rd + 1] = result[63:32];
          }
        }
      }
    }
    PAIR_RORI64 {
      encoding: 6'd3 :: shamt[5:0] :: rs1[4:0] :: 3'd7 :: rd[4:0] :: 7'b0001011;
      assembly: {"pair.rori64", "{name(rd)}, {name(rs1)}, {shamt}"};
      behavior: {
        if (((rd | rs1) & 1) != 0) {
          raise(0, RV_CAUSE_ILLEGAL_INSTRUCTION);
        } else {
          unsigned<64> a = 0;
          if (rs1 != 0) a = X[rs1 + 1] :: X[rs1];
          unsigned<64> result = (unsigned<64>)((a >> shamt) | (a << ((64 - (unsigned<32>)shamt) & 63)));
          if (rd != 0) {
