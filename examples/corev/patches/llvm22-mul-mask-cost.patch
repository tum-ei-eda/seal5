diff --git a/llvm/lib/Target/RISCV/RISCVTargetTransformInfo.cpp b/llvm/lib/Target/RISCV/RISCVTargetTransformInfo.cpp
--- a/llvm/lib/Target/RISCV/RISCVTargetTransformInfo.cpp
+++ b/llvm/lib/Target/RISCV/RISCVTargetTransformInfo.cpp
@@ -247,6 +247,35 @@
     // If the address is a constant, use the materialization cost.
     return getIntImmCost(Imm, Ty, CostKind);
   case Instruction::And:
+    // Generated CORE-V low-half multiplication consumes these masks without
+    // materializing them. Do not hoist them behind constant-fold barriers.
+    if (ST->isRV32() && (ST->hasVendorXCoreVMac() || ST->hasVendorXCoreVSimd()) && Ty->isIntegerTy(32) &&
+        Imm == UINT64_C(0xffff) && Inst && !Inst->use_empty()) {
+      auto IsHalfwordSum = [](const Value *V) {
+        Value *High = nullptr, *Low = nullptr;
+        return match(V, m_c_Add(m_LShr(m_Value(High), m_SpecificInt(16)),
+                                m_c_And(m_Value(Low), m_SpecificInt(65535)))) &&
+               High == Low;
+      };
+      auto IsMaskedMul = [&](const User *U) {
+        auto *Mul = dyn_cast<BinaryOperator>(U);
+        if (!Mul || Mul->getOpcode() != Instruction::Mul)
+          return false;
+        auto IsHalfword = [&](const Value *V) {
+          return match(V, m_c_And(m_Value(), m_SpecificInt(65535))) ||
+                 (ST->hasVendorXCoreVSimd() && IsHalfwordSum(V));
+        };
+        return IsHalfword(Mul->getOperand(0)) &&
+               IsHalfword(Mul->getOperand(1));
+      };
+      auto IsFoldedUse = [&](const User *U) {
+        return IsMaskedMul(U) ||
+               (ST->hasVendorXCoreVSimd() && IsHalfwordSum(U) &&
+                !U->use_empty() && llvm::all_of(U->users(), IsMaskedMul));
+      };
+      if (llvm::all_of(Inst->users(), IsFoldedUse))
+        return TTI::TCC_Free;
+    }
     // zext.h
     if (Imm == UINT64_C(0xffff) && ST->hasStdExtZbb())
       return TTI::TCC_Free;
