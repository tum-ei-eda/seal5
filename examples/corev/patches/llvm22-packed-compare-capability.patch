+// SLP sometimes packs the boolean results of scalar comparisons without
+// packing their operands, especially for a shared broadcast operand. Recover
+// the vector operation before legalization rather than matching expanded lanes.
+static bool combinePackedCompareLanes(Module &M) {
+  bool Changed = false;
+  const DataLayout &DL = M.getDataLayout();
+  SmallVector<SExtInst *, 8> Extensions;
+  for (auto &F : M)
+    for (auto &BB : F)
+      for (auto &I : BB)
+        if (auto *Ext = dyn_cast<SExtInst>(&I))
+          Extensions.push_back(Ext);
+  for (auto *Ext : Extensions) {
+    auto *DstTy = dyn_cast<FixedVectorType>(Ext->getType());
+    if (!DstTy || DstTy->getPrimitiveSizeInBits() != 32 ||
+        (DstTy->getScalarSizeInBits() != 8 && DstTy->getScalarSizeInBits() != 16))
+      continue;
+    unsigned N = DstTy->getNumElements();
+    SmallVector<ICmpInst *, 4> Comparisons(N, nullptr);
+    Value *V = Ext->getOperand(0);
+    bool Valid = true;
+    for (unsigned I = 0; I < N; ++I) {
+      auto *Insert = dyn_cast<InsertElementInst>(V);
+      auto *Index = Insert ? dyn_cast<ConstantInt>(Insert->getOperand(2)) : nullptr;
+      auto *Cmp = Insert ? dyn_cast<ICmpInst>(Insert->getOperand(1)) : nullptr;
+      if (!Index || Index->getZExtValue() >= N || !Cmp ||
+          Comparisons[Index->getZExtValue()] ||
+          Cmp->getOperand(0)->getType() != DstTy->getElementType()) {
+        Valid = false;
+        break;
+      }
+      Comparisons[Index->getZExtValue()] = Cmp;
+      V = Insert->getOperand(0);
+    }
+    if (!Valid || !isa<UndefValue>(V))
+      continue;
+    auto Pred = Comparisons[0]->getPredicate();
+    if (llvm::any_of(Comparisons, [&](auto *C) { return C->getPredicate() != Pred; }))
+      continue;
+    IRBuilder<> B(Ext);
+    auto Pack = [&](unsigned Operand) -> Value * {
+      SmallVector<Value *, 4> Values;
+      for (auto *Cmp : Comparisons)
+        Values.push_back(Cmp->getOperand(Operand));
+      if (llvm::all_of(Values, [&](Value *X) { return X == Values[0]; })) {
+        Changed = true;
+        return B.CreateVectorSplat(N, Values[0]);
+      }
+      auto *First = dyn_cast<LoadInst>(Values[0]);
+      if (!First || First->isVolatile() || First->isAtomic() ||
+          First->getParent() != Ext->getParent())
+        return nullptr;
+      int64_t Start = 0;
+      Value *Base = GetPointerBaseWithConstantOffset(First->getPointerOperand(), Start, DL);
+      Instruction *Earliest = First;
+      for (unsigned I = 0; I < N; ++I) {
+        auto *Load = dyn_cast<LoadInst>(Values[I]);
+        int64_t Offset = 0;
+        if (!Load || Load->isVolatile() || Load->isAtomic() ||
+            Load->getParent() != Ext->getParent() || !Load->comesBefore(Ext) ||
+            GetPointerBaseWithConstantOffset(Load->getPointerOperand(), Offset, DL) != Base ||
