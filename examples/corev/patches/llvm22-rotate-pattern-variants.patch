+// A rotate is the identity when its count modulo the word width is zero.
+// Require the same value and count in both arms before removing the guard.
+static std::vector<std::string> rotatePatternVariants(PatternNode *Root) {
+  auto *Select = dyn_cast<TernopNode>(Root);
+  if (!Select || Select->Op != TargetOpcode::G_SELECT ||
+      Select->Type != LLT::scalar(32))
+    return {};
+  auto *Cmp = dyn_cast<BinopNode>(Select->First.get());
+  auto *Rotate = dyn_cast<BinopNode>(Select->Third.get());
+  if (!Cmp || Cmp->Op != ISD::SETCC ||
+      static_cast<CompareNode *>(Cmp)->Cond != CmpInst::ICMP_EQ ||
+      !Rotate || Rotate->Op != TargetOpcode::G_ROTR ||
+      Rotate->Type != LLT::scalar(32))
+    return {};
+  auto *Mask = dyn_cast<BinopNode>(Cmp->Left.get());
+  auto *Zero = dyn_cast<ConstantNode>(Cmp->Right.get());
+  if (!Mask || Mask->Op != TargetOpcode::G_AND ||
+      Mask->Type != LLT::scalar(32) || !Zero || Zero->Constant != 0)
+    return {};
+  auto *WidthMask = dyn_cast<ConstantNode>(Mask->Right.get());
+  if (!WidthMask || WidthMask->Constant != 31 ||
+      Mask->Left->patternString() != Rotate->Right->patternString() ||
+      Select->Second->patternString() != Rotate->Left->patternString())
+    return {};
+  return {Rotate->patternString()};
+}
