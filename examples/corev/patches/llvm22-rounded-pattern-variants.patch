+// Wrapping rounded subtraction can be written either as (a + round) - b
+// or (a - b) + round. Keep both trees when normalization is specialized.
+static std::vector<std::string> roundedArithmeticPatternVariants(PatternNode *Root) {
+  auto *Shift = dyn_cast<BinopNode>(Root);
+  if (!Shift || Shift->Type != LLT::scalar(32) ||
+      (Shift->Op != TargetOpcode::G_ASHR && Shift->Op != TargetOpcode::G_LSHR))
+    return {};
+  auto *Count = dyn_cast<ConstantNode>(Shift->Right.get());
+  auto *Sub = dyn_cast<BinopNode>(Shift->Left.get());
+  if (!Count || Count->Type != LLT::scalar(32) || Count->Constant == 0 ||
+      Count->Constant > 31 || !Sub || Sub->Op != TargetOpcode::G_SUB ||
+      Sub->Type != LLT::scalar(32))
+    return {};
+  auto *Add = dyn_cast<BinopNode>(Sub->Left.get());
+  if (!Add || Add->Op != TargetOpcode::G_ADD || Add->Type != LLT::scalar(32))
+    return {};
+  auto *Round = dyn_cast<ConstantNode>(Add->Right.get());
+  if (!Round || Round->Type != LLT::scalar(32) ||
+      Round->Constant != (uint64_t(1) << (Count->Constant - 1)))
+    return {};
+  std::string Op = Shift->Op == TargetOpcode::G_ASHR ? "sra" : "srl";
+  return {"(" + Op + " (add (sub " + Add->Left->patternString() + ", " +
+          Sub->Right->patternString() + "), " + Round->patternString() + "), " +
+          Count->patternString() + ")"};
+}
