+// Return equivalent scalar clamp trees only when the bounds are ordered.
+// The optimizer may interchange signed/unsigned min for nonnegative operands;
+// source-level min(max()) and max(min()) also need separate TableGen rules.
+static std::vector<std::string> clampPatternVariants(PatternNode *Root) {
+  auto Unwrap = [](PatternNode *N) {
+    while (auto *Cast = dyn_cast<CastNode>(N)) {
+      if (Cast->Type != Cast->Value->Type)
+        break;
+      N = Cast->Value.get();
+    }
+    return N;
+  };
+  Root = Unwrap(Root);
+  if (Root->Type != LLT::scalar(32))
+    return {};
+  auto Constant = [&](PatternNode *N) -> std::optional<int32_t> {
+    if (auto *C = dyn_cast<ConstantNode>(Unwrap(N));
+        C && C->Type == LLT::scalar(32))
+      return static_cast<int32_t>(C->Constant);
+    return std::nullopt;
+  };
+  auto Nonnegative = [&](PatternNode *N) {
+    if (auto C = Constant(N))
+      return *C >= 0;
+    auto *B = dyn_cast<BinopNode>(Unwrap(N));
+    if (!B || B->Op != TargetOpcode::G_AND)
+      return false;
+    auto L = Constant(B->Left.get()), R = Constant(B->Right.get());
+    return (L && *L >= 0) || (R && *R >= 0);
+  };
+
+  auto *Outer = dyn_cast<BinopNode>(Root);
+  if (!Outer)
+    return {};
+  PatternNode *Value = nullptr;
+  std::string Lower, Upper;
+  bool UnsignedMin = false;
+  if (Outer->Op == TargetOpcode::G_SMIN ||
+      Outer->Op == TargetOpcode::G_UMIN) {
+    auto *Inner = dyn_cast<BinopNode>(Unwrap(Outer->Left.get()));
+    if (!Inner || Inner->Op != TargetOpcode::G_SMAX)
+      return {};
+    auto *L = Unwrap(Inner->Right.get());
+    auto *H = Unwrap(Outer->Right.get());
+    auto LC = Constant(L), HC = Constant(H);
+    bool Ordered = LC && HC && *LC <= *HC;
+    if (LC && *LC == 0 && Nonnegative(H))
+      Ordered = true;
+    if (auto *Not = dyn_cast<BinopNode>(L);
+        Not && Not->Op == TargetOpcode::G_XOR &&
+        Constant(Not->Right.get()) == std::optional<int32_t>(-1) &&
+        Unwrap(Not->Left.get())->patternString() == H->patternString() &&
+        Nonnegative(H))
+      Ordered = true;
+    if (!Ordered || (Outer->Op == TargetOpcode::G_UMIN &&
+                     (!LC || *LC < 0 || !Nonnegative(H))))
+      return {};
+    Value = Inner->Left.get();
+    Lower = L->patternString();
+    Upper = H->patternString();
+    UnsignedMin = LC && *LC >= 0 && Nonnegative(H);
+  } else if (Outer->Op == TargetOpcode::G_ASHR &&
+             Constant(Outer->Right.get()) == std::optional<int32_t>(31)) {
+    // Arithmetic sign replication is clamp(x, -1, 0).
+    Value = Outer->Left.get();
+    Lower = "(i32 -1)";
+    Upper = "(i32 0)";
+  } else if (Outer->Op == ISD::SETCC &&
+             static_cast<CompareNode *>(Outer)->Cond == CmpInst::ICMP_SGT &&
+             Constant(Outer->Right.get()) == std::optional<int32_t>(0)) {
+    // A word-sized signed-positive predicate is clamp(x, 0, 1).
+    Value = Outer->Left.get();
+    Lower = "(i32 0)";
+    Upper = "(i32 1)";
+    UnsignedMin = true;
+  } else {
+    return {};
+  }
+  std::string V = Value->patternString();
+  std::vector<std::string> Variants = {
+      "(smin (smax " + V + ", " + Lower + "), " + Upper + ")",
+      "(smax (smin " + V + ", " + Upper + "), " + Lower + ")"};
+  if (UnsignedMin)
+    Variants.push_back("(umin (smax " + V + ", " + Lower + "), " + Upper + ")");
+  Variants.erase(std::remove(Variants.begin(), Variants.end(),
+                             Root->patternString()),
+                 Variants.end());
+  return Variants;
+}
