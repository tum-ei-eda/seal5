# RUN: llc -mtriple=riscv32 -mattr=+m,+gpr32v,+xcorevsimd -run-pass=riscv-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s
# Products fitting signed 16 bits may bypass truncation/sign-extension.
# Keep the extension when either endpoint can overflow, including +65025
# for unsigned-byte multiplication and -65408 for unsigned-nine-bit * i8.

---
name: u8_s8
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11
    %0:_(s32) = COPY $x10
    %1:_(s32) = COPY $x11
    %2:_(s32) = G_CONSTANT i32 255
    %3:_(s32) = G_CONSTANT i32 24
    %4:_(s32) = G_CONSTANT i32 16
    %5:_(s32) = G_AND %0, %2
    %6:_(s32) = G_SHL %1, %3
    %7:_(s32) = G_ASHR %6, %3
    ; CHECK-LABEL: name: u8_s8
    ; CHECK: [[PRODUCT:%[0-9]+]]:_(s32) = G_MUL
    ; CHECK-NEXT: $x10 = COPY [[PRODUCT]](s32)
    %10:_(s32) = G_MUL %5, %7
    %11:_(s32) = G_SHL %10, %4
    %12:_(s32) = G_ASHR %11, %4
    $x10 = COPY %12(s32)
    PseudoRET implicit $x10
...

---
name: u9_s8
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11
    %0:_(s32) = COPY $x10
    %1:_(s32) = COPY $x11
    %2:_(s32) = G_CONSTANT i32 511
    %3:_(s32) = G_CONSTANT i32 24
    %4:_(s32) = G_CONSTANT i32 16
    %5:_(s32) = G_AND %0, %2
    %6:_(s32) = G_SHL %1, %3
    %7:_(s32) = G_ASHR %6, %3
    ; CHECK-LABEL: name: u9_s8
    ; CHECK: [[PRODUCT:%[0-9]+]]:_(s32) = G_MUL
    ; CHECK-NEXT: [[SHIFT:%[0-9]+]]:_(s32) = G_SHL [[PRODUCT]],
    ; CHECK-NEXT: [[EXT:%[0-9]+]]:_(s32) = G_ASHR [[SHIFT]],
    ; CHECK-NEXT: $x10 = COPY [[EXT]](s32)
    %10:_(s32) = G_MUL %5, %7
    %11:_(s32) = G_SHL %10, %4
    %12:_(s32) = G_ASHR %11, %4
    $x10 = COPY %12(s32)
    PseudoRET implicit $x10
...

---
name: u8_u8
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11
    %0:_(s32) = COPY $x10
    %1:_(s32) = COPY $x11
    %2:_(s32) = G_CONSTANT i32 255
    %3:_(s32) = G_CONSTANT i32 24
    %4:_(s32) = G_CONSTANT i32 16
    %5:_(s32) = G_AND %0, %2
    %7:_(s32) = G_AND %1, %2
    ; CHECK-LABEL: name: u8_u8
    ; CHECK: [[PRODUCT:%[0-9]+]]:_(s32) = G_MUL
    ; CHECK-NEXT: [[SHIFT:%[0-9]+]]:_(s32) = G_SHL [[PRODUCT]],
    ; CHECK-NEXT: [[EXT:%[0-9]+]]:_(s32) = G_ASHR [[SHIFT]],
    ; CHECK-NEXT: $x10 = COPY [[EXT]](s32)
    %10:_(s32) = G_MUL %5, %7
    %11:_(s32) = G_SHL %10, %4
    %12:_(s32) = G_ASHR %11, %4
    $x10 = COPY %12(s32)
    PseudoRET implicit $x10
...

---
name: s8_s8
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11
    %0:_(s32) = COPY $x10
    %1:_(s32) = COPY $x11
    %2:_(s32) = G_CONSTANT i32 255
    %3:_(s32) = G_CONSTANT i32 24
    %4:_(s32) = G_CONSTANT i32 16
    %9:_(s32) = G_SHL %0, %3
    %5:_(s32) = G_ASHR %9, %3
    %6:_(s32) = G_SHL %1, %3
    %7:_(s32) = G_ASHR %6, %3
    ; CHECK-LABEL: name: s8_s8
    ; CHECK: [[PRODUCT:%[0-9]+]]:_(s32) = G_MUL
    ; CHECK-NEXT: $x10 = COPY [[PRODUCT]](s32)
    %10:_(s32) = G_MUL %5, %7
    %11:_(s32) = G_SHL %10, %4
    %12:_(s32) = G_ASHR %11, %4
    $x10 = COPY %12(s32)
    PseudoRET implicit $x10
...
