import "RVI.core_desc"

InstructionSet XPackedSIMD32 extends RV32I {
  instructions {
    PACK_ADD_2X16 {
      encoding: 7'd0 :: rs2[4:0] :: rs1[4:0] :: 3'd1 :: rd[4:0] :: 7'b0101011;
      assembly: {"pack.add.2x16", "{name(rd)}, {name(rs1)}, {name(rs2)}"};
      behavior: if (rd != 0) {
        X[rd][15:0] = (X[rs1][15:0] + X[rs2][15:0])[15:0];
        X[rd][31:16] = (X[rs1][31:16] + X[rs2][31:16])[15:0];
      }
    }
    PACK_ADD_4X8 {
      encoding: 7'd0 :: rs2[4:0] :: rs1[4:0] :: 3'd0 :: rd[4:0] :: 7'b0101011;
