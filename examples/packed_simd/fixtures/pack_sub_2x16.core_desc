// Investigation fixture: ordinary TableGen patterns only.
InstructionSet PackedSIMD extends RISCVBase {
  instructions {
    PACK_SUB_2X16 {
      encoding: 7'd1 :: rs2[4:0] :: rs1[4:0] :: 3'd1 :: rd[4:0] :: 7'b0001011;
