    GISEL64_NAND {
      encoding: 7'd0 :: rs2[4:0] :: rs1[4:0] :: 3'd0 :: rd[4:0] :: 7'b0001011;
      assembly: {"xgiseltable64.nand", "{name(rd)}, {name(rs1)}, {name(rs2)}"};
