    GISEL64_SUMDIFF {
      encoding: 2'b10 :: rd2[4:0] :: rs2[4:0] :: rs1[4:0] :: 3'd0 :: rd1[4:0] :: 7'b0001011;
      assembly: {"xgiseltable64.sumdiff", "{name(rd1)}, {name(rd2)}, {name(rs1)}, {name(rs2)}"};
      behavior: {
        unsigned<XLEN> a = X[rs1];
        unsigned<XLEN> b = X[rs2];
        if (rd1 != 0) X[rd1] = a + b;
        if (rd2 != 0) X[rd2] = a - b;
      }
    }
  }
}

